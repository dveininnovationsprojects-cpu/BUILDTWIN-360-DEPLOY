{
  "info": {
    "name": "BuildTwin 360 - Staging Smoke Tests",
    "description": "Assertion-based smoke checks run by the staging deploy pipeline (Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_username",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": "Admin@123"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "OpenAPI document is published",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('has openapi field', () => pm.expect(pm.response.json()).to.have.property('openapi'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v3/api-docs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v3",
            "api-docs"
          ]
        }
      }
    },
    {
      "name": "Protected endpoint rejects anonymous request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/projects",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "projects"
          ]
        }
      }
    },
    {
      "name": "Login with wrong password is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('no access token returned', () => { const j = pm.response.json(); pm.expect(j.data && j.data.accessToken).to.not.be.ok; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"{{admin_username}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
        }
      }
    },
    {
      "name": "Login as admin returns a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('access token present', () => pm.expect(j.data.accessToken).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('jwt_token', j.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        }
      }
    },
    {
      "name": "Authenticated request to projects succeeds",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/projects",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "projects"
          ]
        }
      }
    }
  ]
}