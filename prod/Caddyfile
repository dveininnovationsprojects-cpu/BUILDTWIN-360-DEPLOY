# TLS certificates are obtained and renewed automatically (Let's Encrypt) for the DOMAIN in .env.prod.
# DNS for DOMAIN must point at this VM and ports 80 and 443 must be open before the first start.
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:80
}
