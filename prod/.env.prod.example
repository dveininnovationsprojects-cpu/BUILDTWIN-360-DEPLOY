# Copy to prod/.env.prod on the VM (chmod 600). Never commit the real file.
DOMAIN=buildtwin.example.com
POSTGRES_DB=buildtwin
POSTGRES_USER=buildtwin
POSTGRES_PASSWORD=change-me-long-random
# At least 64 random characters; must be a NEW value, not the one that is in the backend repository
JWT_SECRET_KEY=change-me-64-plus-random-characters
APP_SEED_ADMIN_PASSWORD=change-me-strong
# true only for the very first start on an empty database (creates the admin). While KTI-02 is open it also
# creates 10 users with default passwords, so do not go live until KTI-02 is fixed.
APP_SEED_ENABLED=false
